<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: trust user-installed CAs, so the QA harness can serve a local TLS fixture to an emulator. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
